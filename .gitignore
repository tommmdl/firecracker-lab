# Somente código, documentação e evidências revisadas entram no Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/config/
!/docs/
!/scripts/
!/guest/
!/tests/
!/evidence/
/config/*
!/config/vm-config.example.json
!/config/sources.lock.json
!/config/jailer-profile.json
!/config/shutdown-builder.Dockerfile
!/config/kernel.fragment
!/config/busybox.fragment
!/config/keys/
/config/keys/*
!/config/keys/greg-kroah-hartman.asc
__pycache__/
*.pyc
*.ext4
*.squashfs
*.socket
*.log
